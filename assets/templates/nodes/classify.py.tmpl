"""節點：問題分類

DSL: question-classifier / {{DSL_TITLE}}
DSL_ID: {{DSL_ID}}
讀取: query, history
寫入: {{LABEL_FIELD}}, classify_reason
"""

from __future__ import annotations

from node_debug import NodeDebug, log_route
from prompts import CLASSIFY_SYSTEM
from services import chat_json
from state import WorkflowState

# --- META（DEBUG 定位；遷移時填 DSL 真實值）---
NODE_KEY = "classify"
DSL_TYPE = "question-classifier"
DSL_TITLE = "{{DSL_TITLE}}"
DSL_ID = "{{DSL_ID}}"
READS = ("query", "history")
WRITES = ("{{LABEL_FIELD}}", "classify_reason")

# 對齊 DSL classes：id／name 必須與 edge.sourceHandle 及 graph mapping 一致
# 例：Dify classes[].id → 邊標籤
_LABELS = ("{{LABEL_A}}", "{{LABEL_B}}")


def classify_node(state: WorkflowState) -> dict:
    dbg = NodeDebug(NODE_KEY, DSL_TYPE, DSL_TITLE, DSL_ID, state, READS)
    try:
        # --- READ ---
        query = (state.get("query") or "").strip()

        # --- CALL ---
        payload = chat_json(
            [
                {"role": "system", "content": CLASSIFY_SYSTEM},
                {"role": "user", "content": query},
            ],
        )
        label = str(payload.get("label") or _LABELS[0]).strip()
        if label not in _LABELS:
            label = _LABELS[0]

        # --- WRITE ---
        return dbg.ok(
            {
                "{{LABEL_FIELD}}": label,
                "classify_reason": str(payload.get("reason") or ""),
            }
        )
    except Exception as exc:
        return dbg.fail(
            exc,
            fallback={"{{LABEL_FIELD}}": _LABELS[0], "classify_reason": ""},
            error_field="classify_error",
        )


def route_after_classify(state: WorkflowState) -> str:
    """純路由：無 I/O。回傳值必須是 graph conditional edges 的 key（= Dify sourceHandle）。"""
    label = str(state.get("{{LABEL_FIELD}}") or "").strip()
    if label not in _LABELS:
        label = _LABELS[-1]
    return log_route(
        "after_classify",
        DSL_TITLE,
        DSL_ID,
        label,
        condition_summary={"{{LABEL_FIELD}}": label},
    )
