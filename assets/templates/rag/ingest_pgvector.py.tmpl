#!/usr/bin/env python3
"""將文件 chunk 寫入 pgvector（DSL 有 knowledge-retrieval 時使用）。

用法：
  export DATABASE_URL=postgresql://rag:ragpass@127.0.0.1:5433/rag
  python rag/ingest_pgvector.py --dir ./docs --collection default

需要：OPENAI_BASE_URL / OPENAI_API_KEY / EMBEDDING_MODEL
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import sys
from pathlib import Path

# 專案根目錄
ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from services import embed_texts, upsert_rag_documents  # noqa: E402


def _chunk_text(text: str, *, size: int = 800, overlap: int = 120) -> list[str]:
    text = re.sub(r"\n{3,}", "\n\n", text.strip())
    if not text:
        return []
    chunks: list[str] = []
    i = 0
    while i < len(text):
        chunks.append(text[i : i + size])
        i += max(size - overlap, 1)
    return chunks


def _read_file(path: Path) -> str:
    return path.read_text(encoding="utf-8", errors="ignore")


def main() -> None:
    parser = argparse.ArgumentParser(description="Ingest files into pgvector RAG")
    parser.add_argument("--dir", type=Path, required=True, help="文件目錄")
    parser.add_argument("--collection", default="default")
    parser.add_argument("--glob", default="**/*.{md,txt}")
    parser.add_argument("--chunk-size", type=int, default=800)
    parser.add_argument("--overlap", type=int, default=120)
    args = parser.parse_args()

    if not args.dir.is_dir():
        raise SystemExit(f"目錄不存在: {args.dir}")

    paths = sorted(
        p
        for p in args.dir.rglob("*")
        if p.is_file() and p.suffix.lower() in {".md", ".txt", ".markdown"}
    )
    if not paths:
        raise SystemExit("找不到 .md／.txt 檔")

    rows: list[dict] = []
    texts: list[str] = []
    for path in paths:
        content = _read_file(path)
        for idx, chunk in enumerate(
            _chunk_text(content, size=args.chunk_size, overlap=args.overlap)
        ):
            source_key = f"{path.as_posix()}#{idx}"
            rows.append(
                {
                    "collection": args.collection,
                    "source_key": source_key,
                    "title": path.name,
                    "url": None,
                    "path": str(path),
                    "content": chunk,
                    "metadata": {"file": str(path), "chunk": idx},
                }
            )
            texts.append(chunk)

    print(f"files={len(paths)} chunks={len(rows)} embedding…")
    vectors = embed_texts(texts)
    for row, vec in zip(rows, vectors, strict=True):
        row["embedding"] = vec

    n = upsert_rag_documents(rows)
    print(f"upserted={n} collection={args.collection}")
    print(json.dumps({"database_url_set": bool(os.getenv("DATABASE_URL"))}, ensure_ascii=False))


if __name__ == "__main__":
    main()
